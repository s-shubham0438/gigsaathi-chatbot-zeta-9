# GigSaathi AI Chatbot service — environment configuration
# Copy to .env and fill in real values. Never commit the real .env file.

# Service
CHATBOT_SERVICE_HOST=0.0.0.0
CHATBOT_SERVICE_PORT=8000
LOG_LEVEL=INFO

# Existing Node/Express backend (the business-logic authority)
# Same-origin as the value the frontend already uses for VITE_API_URL.
NODE_BACKEND_URL=http://localhost:4000/api

# MongoDB
# Same database the Node backend uses. The Python service only reads
# existing collections and writes to its own new `disputes` collection —
# it never writes to User/Booking/Service/ProfessionalProfile/Review.
MONGO_DB_URI=mongodb://127.0.0.1:27017/gigsaathi
MONGO_DB_NAME=gigsaathi

# Ollama / Llama 3.1
# Point this at wherever `ollama serve` is actually running. Not reachable
# from inside this development sandbox — see docs/AI_IMPLEMENTATION_STATE.md.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_REQUEST_TIMEOUT_SECONDS=30

# Support contact (real values, taken from the existing ContactPage.jsx 
# do NOT invent different ones; if these change, update them here only)
SUPPORT_PHONE_HELPLINE=1800-GIG-SAATHI
SUPPORT_PHONE_OFFICE=+91 98230 44120
SUPPORT_EMAIL=support@gigsaathi.demo
SUPPORT_EMAIL_FEDERATION=federation@gigsaathi.demo

# Conversation memory bounds (no unlimited history — see design doc)
CONVERSATION_MAX_TURNS=6
CONVERSATION_TTL_MINUTES=120
